# ──────────────────────────────────────────────────────────────
# GET FROM CONNECT TO YOUR PROJECT ->  SERVER OPTION
# ──────────────────────────────────────────────────────────────

# Supabase project — from the project Connect panel (framework: Astro),
# matching the official Supabase + Astro quickstart.
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Publishable (public) key. Table access is governed by your RLS policies.
PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Service-role (secret) key — server-only, bypasses RLS. Used by the API
# routes to read/write api_credentials and study_cards. NEVER expose this to
# the browser or commit it. Found in Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ──────────────────────────────────────────────────────────────
# Master encryption key for API-credential storage.
# This is the ONE secret that lives OUTSIDE the database and makes the
# stored (encrypted) provider keys decryptable. Keep it safe & backed up —
# losing it means the stored keys can't be recovered.
#
# Generate a fresh 32-byte key (base64) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ──────────────────────────────────────────────────────────────
CREDENTIALS_MASTER_KEY="base64-encoded-32-byte-key"
