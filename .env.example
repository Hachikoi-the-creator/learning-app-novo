# ──────────────────────────────────────────────────────────────
# novostudy — environment variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────

# Supabase project — find these in: Project Settings → API
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Service-role key: used ONLY on the server (API routes). It bypasses RLS,
# so it must never be exposed to the browser or committed to git.
SUPABASE_KEY="your-service-role-key"

# ──────────────────────────────────────────────────────────────
# Master encryption key for API-credential storage.
# This is the ONE secret that lives OUTSIDE the database and makes the
# stored (encrypted) provider keys decryptable. Keep it safe & backed up —
# losing it means the stored keys can't be recovered.
#
# Generate a fresh 32-byte key (base64) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ──────────────────────────────────────────────────────────────
CREDENTIALS_MASTER_KEY="base64-encoded-32-byte-key"
