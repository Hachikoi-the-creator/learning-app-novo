---
import Badge from "./ui/Badge.astro";
import Icon from "./ui/Icon.astro";
import { relativeTime, isDue, type StudyCard } from "../lib/srs";

interface Props {
  card: StudyCard;
}
const { card } = Astro.props;
const due = isDue(card);
const rel = relativeTime(card.next_review_at);
---
<article class="card flex flex-col gap-3 p-5 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
  <div class="flex items-start justify-between gap-3">
    <Badge variant="accent">{card.topic_category}</Badge>
    {due ? (
      <Badge variant="warning"><Icon name="clock" size={12} /> Due {rel}</Badge>
    ) : (
      <Badge variant="muted"><Icon name="clock" size={12} /> {rel}</Badge>
    )}
  </div>

  <h3 class="text-base font-semibold leading-snug">{card.title}</h3>

  <div class="prose-note line-clamp-3 text-sm text-muted-foreground" set:html={card.content_html} />

  <div class="mt-auto flex items-center gap-2 border-t border-border/70 pt-3 text-xs text-muted-foreground">
    <span class="inline-flex items-center gap-1">
      <Icon name="flame" size={13} />
      {card.interaction_count} reps
    </span>
    <span class="opacity-50">·</span>
    <span>Reviewed {relativeTime(card.last_interacted_at)}</span>
  </div>
</article>
