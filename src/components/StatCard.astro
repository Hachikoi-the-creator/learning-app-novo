---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
  tone?: "primary" | "success" | "warning" | "accent";
  icon?: string;
}
const { label, value, hint, tone = "primary", icon } = Astro.props;
const toneRing = {
  primary: "bg-primary/15 text-primary",
  success: "bg-success/15 text-success",
  warning: "bg-warning/20 text-warning",
  accent: "bg-accent text-accent-foreground",
}[tone];
---
<div class="card flex items-center gap-4 p-4">
  {icon && (
    <div class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-md)] ${toneRing}`} set:html={icon} />
  )}
  <div class="min-w-0">
    <p class="text-2xl font-bold leading-none">{value}</p>
    <p class="mt-1 text-sm font-medium text-foreground/80">{label}</p>
    {hint && <p class="text-xs text-muted-foreground">{hint}</p>}
  </div>
</div>
