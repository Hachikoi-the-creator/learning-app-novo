---
interface Props {
  id: string;
  title?: string;
  description?: string;
  size?: "md" | "lg" | "xl";
  class?: string;
}
const { id, title, description, size = "lg", class: className = "" } = Astro.props;
const maxW = { md: "max-w-md", lg: "max-w-2xl", xl: "max-w-4xl" }[size];
---
<dialog
  id={id}
  class={`m-auto w-[92vw] ${maxW} rounded-[var(--radius-lg)] border border-border bg-card p-0 text-card-foreground shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm open:animate-in ${className}`}
>
  <div class="flex max-h-[85vh] flex-col">
    {(title || description) && (
      <header class="flex items-start justify-between gap-4 border-b border-border p-5">
        <div>
          {title && <h2 class="text-lg font-semibold">{title}</h2>}
          {description && <p class="mt-1 text-sm text-muted-foreground">{description}</p>}
        </div>
        <button
          class="btn-icon shrink-0 -mr-2 -mt-1"
          aria-label="Close dialog"
          data-close-modal={id}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
    )}
    <div class="overflow-y-auto p-5">
      <slot />
    </div>
    <slot name="footer" />
  </div>
</dialog>

<script>
  // Delegated open/close handling for all dialogs on the page.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>("[data-open-modal]");
    if (opener) {
      const dlg = document.getElementById(opener.dataset.openModal!) as HTMLDialogElement | null;
      dlg?.showModal();
    }
    const closer = target.closest<HTMLElement>("[data-close-modal]");
    if (closer) {
      const dlg = document.getElementById(closer.dataset.closeModal!) as HTMLDialogElement | null;
      dlg?.close();
    }
  });

  // Click on the backdrop closes the dialog.
  document.querySelectorAll<HTMLDialogElement>("dialog").forEach((dlg) => {
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>
